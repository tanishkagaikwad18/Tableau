      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_1481645735010304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews] * [Review Scores Rating]' />
      </column>
      <column caption='Property Categories by Pricing' datatype='string' name='[Calculation_1481645735550977]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt;= 300 THEN &apos;Luxury&apos;&#13;&#10;ELSEIF [Price] &gt;= 150 THEN &apos;Standard&apos;&#13;&#10;ELSE &apos;Budget&apos;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_1481645736230914]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt;= 100 THEN &apos;Highly Reviewed&apos;&#13;&#10;ELSE &apos;Less Reviewed&apos;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_1481645736865795]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt;=  TODAY() THEN &apos;Active Host&apos;&#13;&#10;ELSE &apos;New Host&apos;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_1481645737885702]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 1481645737410565] THEN &apos;Above Limit&apos;&#13;&#10;ELSE &apos;Below Limit&apos;&#13;&#10;END' />
      </column>
